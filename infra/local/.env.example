# Required: Ethereum RPC endpoint
RPC_ENDPOINT=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: Subsquid network preset or EVM chain identifier (default: ethereum-mainnet)
RPC_NETWORK=ethereum-mainnet

# Required: StateOracle contract address
STATE_ORACLE_ADDRESS=0x...

# Optional: Block number where StateOracle was deployed (default: 0)
STATE_ORACLE_DEPLOYMENT_BLOCK=0

# Optional: Fixed reorg-safety depth. When omitted, native finality is used.
# FINALITY_CONFIRMATION=64

# Optional: RPC request rate limit in requests/second (default: 20)
RPC_RATE_LIMIT=20

# Optional: Maximum number of concurrent in-flight RPC requests (default: 10)
RPC_CAPACITY=10

# Optional: Consecutive blocks scheduled per historical ingestion job.
# This is not the JSON-RPC batch-call size (default: 5).
RPC_STRIDE_SIZE=5

# Optional: Historical ingestion jobs processed in parallel. Increasing this
# speeds up catch-up at the cost of additional RPC and memory pressure (default: 5).
RPC_STRIDE_CONCURRENCY=5

# Optional: Subsquid gateway or Portal dataset for accelerated ingestion.
# Legacy v2 gateway URLs are translated to their current Portal dataset URL.
# SQD_GATEWAY=https://v2.archive.subsquid.io/network/ethereum-mainnet
# SQD_API_KEY=YOUR_KEY

# Optional: Port for the GraphQL API server (default: 4350)
GRAPHQL_SERVER_PORT=4350

# Database (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=squid

DB_USER=postgres
DB_PASS=postgres
